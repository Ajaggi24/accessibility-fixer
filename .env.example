# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---------------------------------------------------------
# The team uses OpenRouter (no Anthropic key required). Set these two:
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: spacing between requests to respect rate limits (ms).
# OPENROUTER_REQUEST_DELAY_MS=1500

# Only needed if you run the teammates' Anthropic-SDK fixers with --real:
ANTHROPIC_API_KEY=your-key-here

# --- Target sites ---------------------------------------------------------
# Local URL Role 1 serves target-site/ on
TARGET_SITE_URL=http://localhost:8000/A11yGoat/

# Local URL Role 1 serves the second/unseen site on (generalization test)
SECOND_SITE_URL=http://localhost:8001

# Optional: override the verify URL (fixed copy served on :8002). Needed when
# the target lives in a subpath of the fixed copy, e.g. bada11y:
# FIXED_SITE_URL=http://localhost:8002/bada11y/
